{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone Doppler generation installation evidence",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/installation"
    },
    {
      "$ref": "#/$defs/summary"
    },
    {
      "$ref": "#/$defs/retained"
    },
    {
      "$ref": "#/$defs/audit"
    }
  ],
  "$defs": {
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "classification",
        "sources",
        "packages",
        "workspaceRoots",
        "files",
        "scope"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "classification": {
          "const": "standalone-installation"
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "providers",
            "reference"
          ],
          "properties": {
            "contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "providers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "archive",
              "sha256"
            ],
            "properties": {
              "name": {
                "enum": [
                  "doe-gpu",
                  "doppler-gpu",
                  "webgpu"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "archive": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "workspaceRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "classification",
        "installationSha256",
        "offlineReinstallationPassed",
        "checks",
        "passed"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "classification": {
          "const": "standalone-installation"
        },
        "installationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offlineReinstallationPassed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "lane",
              "passed",
              "exitCode",
              "expectedFailure"
            ],
            "properties": {
              "label": {
                "enum": [
                  "doe-first",
                  "doe-reopen",
                  "dawn-control",
                  "missing-library",
                  "incompatible-package",
                  "missing-model"
                ]
              },
              "lane": {
                "enum": [
                  "doe",
                  "dawn"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "exitCode": {
                "type": "integer"
              },
              "expectedFailure": {
                "enum": [
                  null,
                  "MISSING_LIBRARY",
                  "INCOMPATIBLE_PACKAGE",
                  "MISSING_MODEL"
                ]
              }
            }
          },
          "minItems": 6,
          "maxItems": 6
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "retained": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "classification",
        "localBundle",
        "artifacts",
        "scope"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "classification": {
          "const": "standalone-installation-evidence"
        },
        "localBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "lane": {
          "enum": [
            "doe",
            "dawn"
          ]
        },
        "label": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "failure": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ]
            }
          ]
        },
        "workspaceProbes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "accessible": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "accessible"
            ]
          }
        },
        "networkInterfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "address": {
                  "type": "string"
                },
                "netmask": {
                  "type": "string"
                },
                "family": {
                  "type": "string"
                },
                "mac": {
                  "type": "string"
                },
                "internal": {
                  "type": "boolean"
                },
                "cidr": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scopeid": {
                  "type": "integer"
                }
              },
              "required": [
                "address",
                "netmask",
                "family",
                "mac",
                "internal",
                "cidr"
              ]
            }
          }
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nativePath": {
          "type": "string"
        },
        "nativeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sharedObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nativeLoaded": {
          "type": "boolean"
        },
        "addonLoaded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "lane",
        "label",
        "passed",
        "failure"
      ]
    }
  }
}
