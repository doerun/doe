+/// Tracks native allocation access within one recording. Epoch changes protect
+/// against allocator reuse even when a replacement has a different public id.
+pub const ReplayAccesses = struct {
+    const Access = struct { memory: c.VkDeviceMemory, writes: bool };
+    command_buffer: c.VkCommandBuffer = null,
+    allocation_epoch: u64 = 0,
+    valid: bool = false,
+    count: usize = 0,
+    accesses: [MAX_TRACKED_COMPUTE_BINDINGS]Access = undefined,
+
+    pub fn beforeDispatch(self: *ReplayAccesses, command_buffer: c.VkCommandBuffer, allocation_epoch: u64, bindings: []const descriptor_identity.Binding) bool {
+        for (bindings) |binding| {
+            if (binding.declaration.resource_kind == .sampler) continue;
+            if (binding.declaration.resource_kind != .buffer or binding.generation == 0 or binding.handle == VK_NULL_U64 or binding.backing_handle == VK_NULL_U64) {
+                self.* = .{};
+                return true;
+            }
+        }
+        var needs_barrier = !self.valid or self.command_buffer != command_buffer or
+            self.allocation_epoch != allocation_epoch or allocation_epoch == 0;
+        if (!needs_barrier) for (bindings) |binding| {
+            if (binding.declaration.resource_kind != .buffer) continue;
+            const writes = access_for_buffer_binding(binding.declaration).writes;
+            for (self.accesses[0..self.count]) |previous| {
+                if (previous.memory == binding.backing_handle and (previous.writes or writes)) {
+                    needs_barrier = true;
+                    break;
+                }
+            }
+        };
+        // Capacity is a conservative synchronization boundary, never a reason
+        // to forget an outstanding access while authorizing barrier elision.
+        if (bindings.len > MAX_TRACKED_COMPUTE_BINDINGS - self.count) needs_barrier = true;
+        if (needs_barrier) self.count = 0;
+        self.command_buffer = command_buffer;
+        self.allocation_epoch = allocation_epoch;
+        self.valid = true;
+        for (bindings) |binding| {
+            if (binding.declaration.resource_kind != .buffer) continue;
+            const writes = access_for_buffer_binding(binding.declaration).writes;
+            var found = false;
+            for (self.accesses[0..self.count]) |*previous| {
+                if (previous.memory != binding.backing_handle) continue;
+                previous.writes = previous.writes or writes;
+                found = true;
+                break;
+            }
+            if (found) continue;
+            if (self.count == MAX_TRACKED_COMPUTE_BINDINGS) {
+                self.* = .{};
+                return true;
+            }
+            self.accesses[self.count] = .{ .memory = binding.backing_handle, .writes = writes };
+            self.count += 1;
+        }
+        return needs_barrier;
+    }
+};
