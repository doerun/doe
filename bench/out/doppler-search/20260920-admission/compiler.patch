+        const shifted = try self.function.append_expr(self.allocator, .{
+            .ty = result_ty,
+            .category = .value,
+            .data = .{ .binary = .{ .op = .shift_right, .lhs = splat, .rhs = offsets } },
+        });
+        return .{ .binary = .{ .op = .bit_and, .lhs = shifted, .rhs = masks } };
+    }
