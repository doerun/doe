+            .unary => |value| self.readOnlyExpr(value.operand, depth - 1),
+            .binary => |value| self.readOnlyExpr(value.lhs, depth - 1) and self.readOnlyExpr(value.rhs, depth - 1),
+            .member => |value| self.readOnlyExpr(value.base, depth - 1),
