+                if (call.kind == .builtin) break :blk std.mem.eql(u8, call.name, "dot") or std.mem.eql(u8, call.name, "min") or std.mem.eql(u8, call.name, "max") or std.mem.eql(u8, call.name, "clamp") or std.mem.eql(u8, call.name, "arrayLength");
