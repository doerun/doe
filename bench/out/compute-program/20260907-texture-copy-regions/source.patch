+        model_gpu_types.WGPUTextureFormat_BC3RGBAUnormSrgb,
+        model_gpu_types.WGPUTextureFormat_BC5RGUnorm,
+        model_gpu_types.WGPUTextureFormat_BC5RGSnorm,
