{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repeated application evaluation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "width",
    "height",
    "heatIterations",
    "warmupRuns",
    "timedRuns",
    "processRuns",
    "absoluteTolerance",
    "relativeTolerance",
    "interactiveDeadlineMs",
    "minimumCpuReductionRatio",
    "denoVersion",
    "applications",
    "providers",
    "claimStatus",
    "processTimeoutMs",
    "preparedExecution",
    "percentileMethod"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "oneOf": [
        {
          "const": 2
        },
        {
          "const": 3
        },
        {
          "const": 4
        },
        {
          "const": 5
        }
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "heatIterations": {
      "type": "integer",
      "minimum": 1
    },
    "warmupRuns": {
      "type": "integer",
      "minimum": 1
    },
    "timedRuns": {
      "type": "integer",
      "minimum": 1
    },
    "processRuns": {
      "type": "integer",
      "minimum": 1
    },
    "absoluteTolerance": {
      "type": "number",
      "minimum": 0
    },
    "relativeTolerance": {
      "type": "number",
      "minimum": 0
    },
    "interactiveDeadlineMs": {
      "type": "number",
      "minimum": 1
    },
    "minimumCpuReductionRatio": {
      "type": "number",
      "minimum": 1
    },
    "denoVersion": {
      "type": "string",
      "const": "2.9.6"
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "doe-recorded",
          "doe-webgpu",
          "dawn",
          "wgpu"
        ]
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "claimStatus": {
      "type": "string",
      "const": "diagnostic"
    },
    "processTimeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "preparedExecution": {
      "type": "string",
      "enum": [
        "gpu-recorded",
        "native-recorded"
      ]
    },
    "percentileMethod": {
      "type": "string",
      "const": "nearest-rank"
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "gpuTiming": {
      "type": "string",
      "enum": [
        "off",
        "timestamp-query"
      ]
    },
    "dawnTimestampQuantization": {
      "type": "string",
      "enum": [
        "default",
        "disabled"
      ]
    },
    "wgpuTimestampUnits": {
      "type": "string",
      "enum": [
        "webgpu-nanoseconds",
        "vulkan-ticks"
      ]
    },
    "vulkanDeviceIndex": {
      "type": "integer",
      "minimum": 0
    },
    "timestampPeriodRelativeTolerance": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1e-05,
      "description": "Bound for decimal rounding in the independent vulkaninfo JSON timestamp period."
    },
    "timestampSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/properties/fixtures/additionalProperties"
      }
    },
    "gpuActivity": {
      "type": "string",
      "enum": [
        "off",
        "reject-observed-linux-drm"
      ],
      "description": "Version 5 explicitly controls bracketed Linux DRM observations. Rejection detects visible foreign activity; it does not establish exclusive device access."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "minimum": 3
          }
        }
      },
      "then": {
        "required": [
          "fixtures"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 4
          }
        }
      },
      "then": {
        "required": [
          "gpuTiming",
          "dawnTimestampQuantization",
          "wgpuTimestampUnits",
          "vulkanDeviceIndex",
          "timestampPeriodRelativeTolerance",
          "timestampSources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "maximum": 3
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "gpuTiming"
              ]
            },
            {
              "required": [
                "dawnTimestampQuantization"
              ]
            },
            {
              "required": [
                "wgpuTimestampUnits"
              ]
            },
            {
              "required": [
                "vulkanDeviceIndex"
              ]
            },
            {
              "required": [
                "timestampPeriodRelativeTolerance"
              ]
            },
            {
              "required": [
                "timestampSources"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "gpuTiming"
            ]
          },
          {
            "required": [
              "dawnTimestampQuantization"
            ]
          },
          {
            "required": [
              "wgpuTimestampUnits"
            ]
          },
          {
            "required": [
              "vulkanDeviceIndex"
            ]
          },
          {
            "required": [
              "timestampPeriodRelativeTolerance"
            ]
          },
          {
            "required": [
              "timestampSources"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "gpuTiming",
          "dawnTimestampQuantization",
          "wgpuTimestampUnits",
          "vulkanDeviceIndex",
          "timestampPeriodRelativeTolerance",
          "timestampSources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 5
          }
        }
      },
      "then": {
        "required": [
          "gpuActivity"
        ]
      },
      "else": {
        "not": {
          "required": [
            "gpuActivity"
          ]
        }
      }
    }
  ]
}
