{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen external compute program and oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "application",
    "sourceRepo",
    "sourceCommit",
    "caseId",
    "generatorRuntime",
    "adaptation",
    "program",
    "inputs",
    "expected",
    "sources",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "type": "string",
      "const": "compute_program_fixture"
    },
    "application": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sourceRepo": {
      "type": "string",
      "format": "uri"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "generatorRuntime": {
      "type": "string"
    },
    "adaptation": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "$ref": "#/$defs/reference"
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/reference"
      }
    },
    "expected": {
      "$ref": "#/$defs/reference"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "count",
          "mode",
          "absoluteTolerance",
          "relativeTolerance",
          "relativeEpsilon"
        ],
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "both",
              "exact"
            ]
          },
          "absoluteTolerance": {
            "type": "number",
            "minimum": 0
          },
          "relativeTolerance": {
            "type": "number",
            "minimum": 0
          },
          "relativeEpsilon": {
            "type": "number",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "both"
                }
              }
            },
            "then": {
              "properties": {
                "absoluteTolerance": {
                  "exclusiveMinimum": 0
                },
                "relativeTolerance": {
                  "exclusiveMinimum": 0
                },
                "relativeEpsilon": {
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        ]
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "expected"
      ],
      "properties": {
        "inputs": {
          "const": "initialize-once"
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "sequence"
        ]
      },
      "else": {
        "not": {
          "required": [
            "sequence"
          ]
        }
      }
    }
  ]
}
