{
  "name": "doe-gpu",
  "version": "0.5.0",
  "description": "Zig-first WebGPU runtime for Node.js, Bun, and Deno",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "doe-proof-node": "./bin/doe-proof-node.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "bun": "./src/bun.js",
      "deno": "./src/deno.js",
      "default": "./src/index.js"
    },
    "./api": {
      "types": "./src/api.d.ts",
      "default": "./src/api.js"
    },
    "./native": {
      "types": "./src/native.d.ts",
      "default": "./src/native.js"
    },
    "./node-webgpu": {
      "types": "./src/node-webgpu.d.ts",
      "default": "./src/node-webgpu.js"
    },
    "./node-webgpu-loader": "./src/node-webgpu-loader.js",
    "./node-webgpu-process": {
      "types": "./src/node-webgpu-process.d.ts",
      "default": "./src/node-webgpu-process.js"
    },
    "./governed-node-webgpu-process-contract.schema.json": "./assets/governed-node-webgpu-process-contract.schema.json",
    "./governed-node-webgpu-process-receipt.schema.json": "./assets/governed-node-webgpu-process-receipt.schema.json",
    "./governed-node-webgpu-process-artifact.schema.json": "./assets/governed-node-webgpu-process-artifact.schema.json",
    "./transparent-webgpu-observation.schema.json": "./assets/transparent-webgpu-observation.schema.json",
    "./program-bundle": {
      "types": "./src/program-bundle-runner.d.ts",
      "default": "./src/program-bundle-runner.js"
    },
    "./plan": {
      "types": "./src/plan.d.ts",
      "default": "./src/plan.js"
    },
    "./compute-program": {
      "types": "./src/compute-program.d.ts",
      "default": "./src/compute-program.js"
    },
    "./capture": {
      "types": "./src/capture.d.ts",
      "default": "./src/capture.js"
    },
    "./observe": {
      "types": "./src/observe.d.ts",
      "default": "./src/observe.js"
    },
    "./compute": {
      "types": "./src/compute.d.ts",
      "default": "./src/compute.js"
    },
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./hybrid": {
      "types": "./src/hybrid.d.ts",
      "default": "./src/hybrid.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    "assets/",
    "!src/vendor/build/",
    "scripts/",
    "binding.gyp",
    "README.md"
  ],
  "scripts": {
    "build:addon": "node scripts/build-addon.js",
    "install": "node scripts/install.js",
    "stage:prebuilds": "node scripts/stage-prebuilds.js",
    "test": "npm run test:contracts && npm run test:smoke && npm run test:integration",
    "test:contracts": "node test/run-contracts.js",
    "check:plan-schema": "node scripts/check-plan-schema-parity.js",
    "sync:program-bundle-schema": "node scripts/sync-program-bundle-schema.js",
    "test:smoke": "node test/smoke/test-smoke-load.js",
    "test:integration": "node test/integration/run-integration.js --runtime node",
    "test:integration:native-clean-install": "node test/integration/test-integration-native-clean-install.js --required --runtime node",
    "test:integration:native-clean-install:bun": "node test/integration/test-integration-native-clean-install.js --required --runtime bun",
    "test:integration:native-clean-install:electron": "node test/integration/test-integration-native-clean-install.js --required --runtime electron",
    "test:integration:native-reliability": "node test/integration/test-integration-native-clean-install-reliability.js --required --runtime node",
    "test:integration:native-reliability:bun": "node test/integration/test-integration-native-clean-install-reliability.js --required --runtime bun",
    "test:integration:native-reliability:electron": "node test/integration/test-integration-native-clean-install-reliability.js --required --runtime electron",
    "test:integration:bun": "bun test/integration/run-integration.js --runtime bun",
    "test:integration:deno": "deno run --allow-all test/integration/run-integration.js --runtime deno",
    "prepublishOnly": "node scripts/verify-publish-readiness.js && npm test",
    "sync-vendor": "node scripts/sync-vendor.js"
  },
  "optionalDependencies": {
    "doe-gpu-darwin-arm64": "0.5.0",
    "doe-gpu-linux-x64": "0.5.0"
  },
  "keywords": [
    "webgpu",
    "doe",
    "gpu",
    "headless",
    "compute",
    "ai",
    "ml",
    "wgsl",
    "ci",
    "bun",
    "deno"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doerun/doe.git",
    "directory": "packages/doe-gpu"
  },
  "homepage": "https://github.com/doerun/doe/tree/main/packages/doe-gpu",
  "bugs": {
    "url": "https://github.com/doerun/doe/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Doe",
  "license": "Apache-2.0"
}
