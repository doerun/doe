{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live simulation example policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "width",
    "height",
    "rate",
    "minimumRate",
    "maximumRate",
    "frameIntervalMs",
    "statusEveryFrames",
    "requestTimeoutMs",
    "maximumShaderBytes",
    "maximumProcessOutputBytes",
    "maximumHeapMiB",
    "candidateSteps",
    "candidateRates",
    "candidateInputs",
    "absoluteTolerance",
    "relativeTolerance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "rate": {
      "type": "number",
      "minimum": 0
    },
    "minimumRate": {
      "type": "number",
      "minimum": 0
    },
    "maximumRate": {
      "type": "number",
      "minimum": 0
    },
    "frameIntervalMs": {
      "type": "integer",
      "minimum": 1
    },
    "statusEveryFrames": {
      "type": "integer",
      "minimum": 1
    },
    "requestTimeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "maximumShaderBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumProcessOutputBytes": {
      "type": "integer",
      "minimum": 1
    },
    "maximumHeapMiB": {
      "type": "integer",
      "minimum": 1
    },
    "candidateSteps": {
      "type": "integer",
      "minimum": 1
    },
    "candidateRates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.25
      }
    },
    "candidateInputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "zero",
          "hotspot",
          "ramp",
          "checkerboard"
        ],
        "type": "string"
      }
    },
    "absoluteTolerance": {
      "type": "number",
      "minimum": 0
    },
    "relativeTolerance": {
      "type": "number",
      "minimum": 0
    }
  }
}
