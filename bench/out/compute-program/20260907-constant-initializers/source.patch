+        "const VALUE: vec2<f32> = -vec2<f32>(1.0, 2.0); @compute @workgroup_size(1) fn main() {}",
+        "const VALUE: vec2<u32> = vec2<u32>(1u, 2u) + vec2<u32>(3u, 4u); @compute @workgroup_size(1) fn main() {}",
