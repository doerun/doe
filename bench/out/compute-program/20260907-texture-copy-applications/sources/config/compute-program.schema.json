{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe fixed-shape compute program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "buffers",
    "shaders",
    "steps",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "buffers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/buffer"
      }
    },
    "shaders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shader"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    }
  },
  "$defs": {
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "size",
        "role",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "size": {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991,
          "multipleOf": 4
        },
        "role": {
          "type": "string",
          "enum": [
            "input",
            "scratch",
            "output"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "storage",
            "uniform"
          ]
        },
        "lifetime": {
          "type": "string",
          "enum": [
            "invocation",
            "program"
          ],
          "default": "invocation"
        },
        "stateFormat": {
          "type": "string",
          "minLength": 1,
          "description": "Application-owned interpretation of resident bytes; changing it requires a reset in descriptor version 3."
        }
      }
    },
    "shader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "entryPoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "entryPoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shader",
        "bindings",
        "workgroups"
      ],
      "properties": {
        "shader": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "binding",
              "buffer"
            ],
            "properties": {
              "binding": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "buffer": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              }
            }
          }
        },
        "workgroups": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "maxItems": 3
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution"
      ],
      "properties": {
        "execution": {
          "type": "string",
          "enum": [
            "gpu-recorded",
            "native-recorded",
            "webgpu"
          ]
        },
        "gpuTiming": {
          "type": "string",
          "enum": [
            "off",
            "timestamp-query"
          ],
          "default": "off"
        },
        "readback": {
          "type": "string",
          "enum": [
            "output",
            "none"
          ],
          "default": "output"
        }
      }
    },
    "updateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "previousProgramHash",
        "nextProgramHash",
        "revision",
        "retained",
        "replaced",
        "discarded",
        "created",
        "requiresReset"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "previousProgramHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nextProgramHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retained": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buffer"
          }
        },
        "discarded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buffer"
          }
        },
        "created": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/buffer"
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "before",
              "after"
            ],
            "properties": {
              "before": {
                "$ref": "#/$defs/buffer"
              },
              "after": {
                "$ref": "#/$defs/buffer"
              }
            }
          }
        },
        "requiresReset": {
          "type": "boolean"
        }
      }
    },
    "updateOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "$ref": "#/$defs/updateAssessment"
        },
        "reset": {
          "type": "string",
          "enum": [
            "preserve",
            "approve"
          ],
          "default": "preserve"
        }
      }
    },
    "nativeContractVersion": {
      "type": "integer",
      "const": 2,
      "description": "Required native residency command contract. Descriptor version 3 adds host update policy without changing recorded commands."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "buffers": {
            "items": {
              "not": {
                "required": [
                  "lifetime"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "buffers": {
            "items": {
              "not": {
                "required": [
                  "stateFormat"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "buffers": {
            "items": {
              "if": {
                "required": [
                  "lifetime"
                ],
                "properties": {
                  "lifetime": {
                    "const": "program"
                  }
                }
              },
              "then": {
                "required": [
                  "stateFormat"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "stateFormat"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
