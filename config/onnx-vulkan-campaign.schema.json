        },
        "buildType": {
          "type": "string",
          "const": "Release"
        },
        "backend": {
          "type": "string",
          "const": "Vulkan"
        },
        "vendorId": {
          "type": "integer",
          "const": 4098
        },
        "contextId": {
          "type": "integer",
          "const": 0
        }
      }
