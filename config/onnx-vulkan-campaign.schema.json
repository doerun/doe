        "retainUnfavorableResults": {
          "type": "boolean",
          "const": true
        },
        "compilerCampaign": {
          "type": "string",
          "const": "new-concrete-reproduction-required"
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
