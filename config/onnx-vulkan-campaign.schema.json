        "aaPairs": {
          "type": "integer",
          "const": 4
        },
        "maximumAaMedianRatio": {
          "type": "number",
          "const": 1.05
        },
        "confidence": {
          "type": "number",
          "const": 0.95
        },
        "bootstrapResamples": {
          "type": "integer",
          "const": 10000
        },
        "bootstrapSeed": {
          "type": "integer",
          "const": 31005
        },
        "diskCache": {
          "type": "string",
          "const": "fresh-per-cold-process; separately-preconditioned-per-arm-for-warm"
        },
        "coldProcessesPerArm": {
          "type": "integer",
          "const": 4
        },
        "regressionMaximumRatios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "warmP95",
            "coldProcessWall",
            "processCpu",
            "peakRss"
          ],
          "properties": {
            "warmP95": {
              "type": "number",
              "const": 1.05
            },
            "coldProcessWall": {
              "type": "number",
              "const": 1.1
            },
            "processCpu": {
              "type": "number",
              "const": 1.05
            },
            "peakRss": {
              "type": "number",
              "const": 1.1
            }
          }
        }
      }
