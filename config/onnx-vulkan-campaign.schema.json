    "stopping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopBeforeTimingOnSafetyOrCorrectnessFailure",
        "stopOnAaFailure",
        "maximumPerformanceCorrections",
        "minimumProfileOwnerShare",
        "minimumPredictedGainRatio",
        "retainUnfavorableResults",
        "compilerCampaign",
        "deferred"
      ],
      "properties": {
        "stopBeforeTimingOnSafetyOrCorrectnessFailure": {
          "type": "boolean",
          "const": true
        },
        "stopOnAaFailure": {
          "type": "boolean",
          "const": true
        },
        "maximumPerformanceCorrections": {
          "type": "integer",
          "const": 1
        },
        "minimumProfileOwnerShare": {
          "type": "number",
          "const": 0.15
        },
        "minimumPredictedGainRatio": {
          "type": "number",
          "const": 1.1
