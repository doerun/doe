{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe external project harness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "actorId",
    "harnessId",
    "upstream",
    "providerSubstitution",
    "fallbackPolicy",
    "workload",
    "requiredMeasurements",
    "requiredReceiptFields",
    "installation",
    "reproduction",
    "supportTargets",
    "reliabilityPolicy",
    "performancePolicy",
    "receiptPolicy",
    "releasePolicy"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [4, 5] },
    "artifactKind": { "type": "string", "const": "external-project-harness" },
    "actorId": { "$ref": "#/$defs/id" },
    "harnessId": { "$ref": "#/$defs/id" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "commit", "license"],
      "properties": {
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "evidenceUrl"],
          "properties": {
            "identifier": { "type": "string", "minLength": 1 },
            "evidenceUrl": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "providerSubstitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineProvider", "comparisonProvider", "seam", "patchPaths"],
      "properties": {
        "baselineProvider": { "type": "string", "const": "dawn-node-webgpu" },
        "comparisonProvider": { "type": "string", "const": "doe-gpu" },
        "seam": { "type": "string", "minLength": 1 },
        "patchPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "runtimeOwnershipPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimedProperty",
        "incumbentLimitation",
        "applicationConsequence",
        "materialOutcome",
        "lanes",
        "ownershipCosts"
      ],
      "properties": {
        "claimedProperty": { "$ref": "#/$defs/runtimeOwnershipProperty" },
        "incumbentLimitation": { "type": "string", "minLength": 1 },
        "applicationConsequence": { "type": "string", "minLength": 1 },
        "materialOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "decisionRule"],
          "properties": {
            "metric": { "type": "string", "minLength": 1 },
            "decisionRule": { "type": "string", "minLength": 1 }
          }
        },
        "lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["I0", "I1", "W0", "D0", "P0"],
          "properties": {
            "I0": { "$ref": "#/$defs/runtimeOwnershipLanePlan" },
            "I1": { "$ref": "#/$defs/runtimeOwnershipLanePlan" },
            "W0": { "$ref": "#/$defs/runtimeOwnershipLanePlan" },
            "D0": { "$ref": "#/$defs/runtimeOwnershipLanePlan" },
            "P0": { "$ref": "#/$defs/runtimeOwnershipLanePlan" }
          }
        },
        "ownershipCosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "owned-source-surface",
              "webgpu-compatibility",
              "platform-driver-matrix",
              "native-security",
              "release-packaging",
              "upstream-ingestion",
              "application-exceptions",
              "regression-support"
            ]
          }
        }
      }
    },
    "fallbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireHardware", "prohibitedFallbacks", "providerIdentityAssertion"],
      "properties": {
        "requireHardware": { "type": "boolean", "const": true },
        "prohibitedFallbacks": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["cpu", "mock", "software-renderer", "unknown-provider"]
          },
          "allOf": [
            { "contains": { "const": "cpu" } },
            { "contains": { "const": "mock" } },
            { "contains": { "const": "software-renderer" } }
          ]
        },
        "providerIdentityAssertion": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "immutableInputRefs",
        "oracle",
        "sameWorkPolicy",
        "completionBoundary"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "immutableInputRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "reviewStatus"],
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["upstream", "independent-replacement"]
            },
            "path": { "$ref": "#/$defs/repoPath" },
            "reviewStatus": { "type": "string", "const": "reviewed" }
          }
        },
        "modelContract": { "$ref": "#/$defs/modelContract" },
        "sameWorkPolicy": { "type": "string", "minLength": 1 },
        "completionBoundary": { "type": "string", "minLength": 1 }
      }
    },
    "requiredMeasurements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "clean-process-success",
          "crashes",
          "hangs",
          "timeouts",
          "peak-memory-bytes",
          "cold-p50",
          "cold-p95",
          "cold-p99",
          "warm-p50",
          "warm-p95",
          "warm-p99",
          "receipt-overhead"
        ]
      },
      "allOf": [
        { "contains": { "const": "clean-process-success" } },
        { "contains": { "const": "crashes" } },
        { "contains": { "const": "hangs" } },
        { "contains": { "const": "timeouts" } },
        { "contains": { "const": "peak-memory-bytes" } },
        { "contains": { "const": "cold-p50" } },
        { "contains": { "const": "cold-p95" } },
        { "contains": { "const": "cold-p99" } },
        { "contains": { "const": "warm-p50" } },
        { "contains": { "const": "warm-p95" } },
        { "contains": { "const": "warm-p99" } },
        { "contains": { "const": "receipt-overhead" } }
      ]
    },
    "requiredReceiptFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "provider-identity",
          "adapter-identity",
          "driver-identity",
          "shader-hashes",
          "dispatch-shape",
          "synchronization",
          "readback",
          "output-identity"
        ]
      },
      "allOf": [
        { "contains": { "const": "provider-identity" } },
        { "contains": { "const": "adapter-identity" } },
        { "contains": { "const": "driver-identity" } },
        { "contains": { "const": "shader-hashes" } },
        { "contains": { "const": "dispatch-shape" } },
        { "contains": { "const": "synchronization" } },
        { "contains": { "const": "readback" } },
        { "contains": { "const": "output-identity" } }
      ]
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "substitutionMode",
        "productionStatus",
        "applicationSourceUnchanged",
        "shaderSourceUnchanged",
        "installSteps",
        "validationCommand",
        "timeoutSeconds"
      ],
      "properties": {
        "substitutionMode": {
          "type": "string",
          "enum": ["package-alias", "provider-factory", "esm-loader", "native-library", "other"]
        },
        "productionStatus": {
          "type": "string",
          "enum": ["unvalidated", "harness-only", "validated"]
        },
        "applicationSourceUnchanged": { "type": "boolean" },
        "shaderSourceUnchanged": { "type": "boolean" },
        "installSteps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/installStep" }
        },
        "validationCommand": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerModulePath", "arguments", "evidenceFiles"],
      "properties": {
        "providerModulePath": { "$ref": "#/$defs/workspacePath" },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[^{}]|\\{(?:actorId|harnessId|runId|runRoot|upstreamRoot|preparationReceipt)\\})*$"
          }
        },
        "evidenceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "path": { "$ref": "#/$defs/runRelativePath" }
            }
          }
        }
      }
    },
    "supportTargets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/supportTarget" }
    },
    "reliabilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanProcessRunsPerProvider",
        "concurrencyLevel",
        "concurrencyRunsPerProvider",
        "teardownCyclesPerProvider",
        "stressIterationsPerProvider",
        "processTimeoutSeconds",
        "memoryGrowthBoundaryBytes",
        "requireZeroCrashes",
        "requireZeroHangs",
        "requireZeroTimeouts"
      ],
      "properties": {
        "cleanProcessRunsPerProvider": { "type": "integer", "minimum": 1 },
        "concurrencyLevel": { "type": "integer", "minimum": 1 },
        "concurrencyRunsPerProvider": { "type": "integer", "minimum": 0 },
        "teardownCyclesPerProvider": { "type": "integer", "minimum": 0 },
        "stressIterationsPerProvider": { "type": "integer", "minimum": 0 },
        "processTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "memoryGrowthBoundaryBytes": { "type": "integer", "minimum": 0 },
        "requireZeroCrashes": { "type": "boolean", "const": true },
        "requireZeroHangs": { "type": "boolean", "const": true },
        "requireZeroTimeouts": { "type": "boolean", "const": true }
      }
    },
    "performancePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timingScope",
        "coldSamplesPerProvider",
        "warmupSamplesPerProvider",
        "warmSamplesPerProvider",
        "requiredPercentiles",
        "throughputMetric",
        "minimumMaterialSpeedupRatio",
        "maximumRegressionRatio"
      ],
      "properties": {
        "timingScope": { "type": "string", "minLength": 1 },
        "coldSamplesPerProvider": { "type": "integer", "minimum": 1 },
        "warmupSamplesPerProvider": { "type": "integer", "minimum": 0 },
        "warmSamplesPerProvider": { "type": "integer", "minimum": 1 },
        "requiredPercentiles": { "type": "array", "const": ["p50", "p95", "p99"] },
        "throughputMetric": { "type": "string", "minLength": 1 },
        "minimumMaterialSpeedupRatio": { "type": "number", "exclusiveMinimum": 1 },
        "maximumRegressionRatio": { "type": "number", "minimum": 1 }
      }
    },
    "receiptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureRequired",
        "replayRequired",
        "runtimeBuildIdentityRequired",
        "preparationReceiptRequired"
      ],
      "properties": {
        "captureRequired": { "type": "boolean", "const": true },
        "replayRequired": { "type": "boolean" },
        "runtimeBuildIdentityRequired": { "type": "boolean", "const": true },
        "preparationReceiptRequired": { "type": "boolean", "const": true }
      }
    },
    "releasePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotionState", "blocking", "command", "promotionReportIds"],
      "properties": {
        "promotionState": {
          "type": "string",
          "enum": ["not-promoted", "candidate", "promoted", "suspended", "retired"]
        },
        "blocking": { "type": "boolean" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "promotionReportIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^bench/external-projects/[a-z0-9][a-z0-9-]*/[^/].*$"
    },
    "workspacePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^{}]+$"
    },
    "runRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^{}]+$"
    },
    "workingDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "path"],
      "properties": {
        "scope": { "type": "string", "enum": ["repo", "upstream"] },
        "path": {
          "type": "string",
          "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^{}]+)$"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hashBoundPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/workspacePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "modelProviderIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wrapper", "targetRoot", "target"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["dawn-node-webgpu", "doe-gpu"]
        },
        "wrapper": { "$ref": "#/$defs/hashBoundPath" },
        "targetRoot": {
          "type": "string",
          "enum": ["repo", "upstream"]
        },
        "target": { "$ref": "#/$defs/hashBoundPath" },
        "sourceBuild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceRevision", "patch", "library", "provenance"],
          "properties": {
            "kind": { "const": "electron-owned-mappings-p0" },
            "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "patch": { "$ref": "#/$defs/hashBoundPath" },
            "library": { "$ref": "#/$defs/hashBoundPath" },
            "provenance": { "$ref": "#/$defs/hashBoundPath" }
          }
        }
      }
    },
    "modelArtifactSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "path", "origin"],
      "properties": {
        "project": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/workspacePath" },
        "origin": { "$ref": "#/$defs/hashBoundPath" }
      }
    },
    "modelContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "artifactSource",
        "manifest",
        "tokenizer",
        "shaderIdentity",
        "application",
        "prompt",
        "execution",
        "providerContract",
        "providers"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "artifactSource": { "$ref": "#/$defs/modelArtifactSource" },
        "manifest": { "$ref": "#/$defs/hashBoundPath" },
        "tokenizer": { "$ref": "#/$defs/hashBoundPath" },
        "shaderIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "sha256"],
          "properties": {
            "source": {
              "type": "string",
              "const": "manifest.inference.execution.kernels"
            },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "version", "mode", "package", "entrypoint"],
          "properties": {
            "runtime": { "type": "string", "const": "electron" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "mode": { "type": "string", "const": "main-process-node-side" },
            "package": { "$ref": "#/$defs/hashBoundPath" },
            "entrypoint": { "$ref": "#/$defs/hashBoundPath" }
          }
        },
        "prompt": { "$ref": "#/$defs/hashBoundPath" },
        "providerContract": { "$ref": "#/$defs/hashBoundPath" },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decodeSteps",
            "useChatTemplate",
            "runtimeProfile",
            "kernelPathPolicy",
            "sampling",
            "checkpointStages",
            "tolerance"
          ],
          "properties": {
            "decodeSteps": { "type": "integer", "minimum": 2 },
            "useChatTemplate": { "type": "boolean" },
            "runtimeProfile": { "type": "string", "minLength": 1 },
            "kernelPathPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "sourceScope", "onIncompatible"],
              "properties": {
                "mode": { "type": "string", "enum": ["locked", "capability-aware"] },
                "sourceScope": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["model", "manifest", "config"]
                  }
                },
                "onIncompatible": { "type": "string", "enum": ["error", "remap"] }
              }
            },
            "sampling": {
              "type": "object",
              "additionalProperties": false,
              "required": ["temperature", "topK", "topP", "repetitionPenalty", "seed"],
              "properties": {
                "temperature": { "type": "number", "minimum": 0 },
                "topK": { "type": "integer", "minimum": 1 },
                "topP": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "repetitionPenalty": { "type": "number", "exclusiveMinimum": 0 },
                "seed": { "type": "integer", "minimum": 0 }
              }
            },
            "checkpointStages": {
              "type": "array",
              "minItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "embedding",
                  "rmsnorm",
                  "qkv",
                  "rope",
                  "attention",
                  "kv",
                  "mlp",
                  "logits"
                ]
              },
              "allOf": [
                { "contains": { "const": "embedding" } },
                { "contains": { "const": "rmsnorm" } },
                { "contains": { "const": "qkv" } },
                { "contains": { "const": "rope" } },
                { "contains": { "const": "attention" } },
                { "contains": { "const": "kv" } },
                { "contains": { "const": "mlp" } },
                { "contains": { "const": "logits" } }
              ]
            },
            "tolerance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "atol", "rtol"],
              "properties": {
                "metric": { "type": "string", "const": "abs-or-relative" },
                "atol": { "type": "number", "minimum": 0 },
                "rtol": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["W0", "D0"],
          "properties": {
            "W0": { "$ref": "#/$defs/modelProviderIdentity" },
            "D0": { "$ref": "#/$defs/modelProviderIdentity" },
            "P0": {
              "allOf": [
                { "$ref": "#/$defs/modelProviderIdentity" },
                { "required": ["sourceBuild"] }
              ]
            }
          }
        }
      }
    },
    "installStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "workingDirectory", "timeoutSeconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "workingDirectory": { "$ref": "#/$defs/workingDirectory" },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "supportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "arch", "runtime", "adapter", "driver", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["planned", "validated", "promoted", "suspended"] }
      }
    },
    "runtimeOwnershipProperty": {
      "type": "string",
      "enum": [
        "enforcement",
        "failure-localization",
        "lifecycle-control",
        "program-identity-preservation",
        "independent-correction",
        "persistent-performance-control",
        "reproducible-runtime-identity"
      ]
    },
    "runtimeOwnershipLanePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "construction"],
      "properties": {
        "requirement": {
          "type": "string",
          "enum": ["required", "conditional", "not-applicable"]
        },
        "construction": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "workload": {
            "properties": {
              "modelContract": {
                "properties": {
                  "providers": {
                    "properties": {
                      "P0": {
                        "not": {}
                      },
                      "W0": {
                        "not": {
                          "required": [
                            "sourceBuild"
                          ]
                        }
                      },
                      "D0": {
                        "not": {
                          "required": [
                            "sourceBuild"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
