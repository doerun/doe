{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vulkan buffer memory selection policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "readbackRequiredProperties",
    "readbackPreferredProperties",
    "unavailablePreference",
    "hostVisiblePreferredProperties",
    "computeBufferCacheMaxBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "readbackRequiredProperties": {
      "const": [
        "host-visible",
        "host-coherent"
      ]
    },
    "readbackPreferredProperties": {
      "const": [
        "host-cached"
      ]
    },
    "unavailablePreference": {
      "const": "use-required-properties"
    },
    "hostVisiblePreferredProperties": {
      "const": [
        "device-local"
      ]
    },
    "computeBufferCacheMaxBytes": {
      "const": 67108864
    }
  }
}
