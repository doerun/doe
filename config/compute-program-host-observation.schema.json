{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "monotonicNs",
    "unixTimeNs",
    "cpuAffinity",
    "scope",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "compute-program-host-observation"
    },
    "monotonicNs": {
      "type": "integer",
      "minimum": 0
    },
    "unixTimeNs": {
      "type": "integer",
      "minimum": 0
    },
    "cpuAffinity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "scope": {
      "const": "cohort-boundary-shared-host"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "error"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host observations at cohort boundaries"
}
