{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct WGSL output experiment settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessions",
    "browser",
    "args",
    "viewport",
    "output",
    "warmupCycles",
    "trialOrders",
    "stoppingRule",
    "statistics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessions": {
      "const": 6
    },
    "browser": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "warmupCycles": {
      "type": "integer",
      "minimum": 1
    },
    "trialOrders": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "enum": [
            "original",
            "disabled",
            "transformed"
          ]
        }
      }
    },
    "stoppingRule": {
      "type": "string",
      "minLength": 1
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "bootstrapResamples",
        "bootstrapSeed",
        "unit",
        "method"
      ],
      "properties": {
        "confidence": {
          "const": 0.95
        },
        "bootstrapResamples": {
          "type": "integer",
          "minimum": 10000
        },
        "bootstrapSeed": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "independent-browser-process"
        },
        "method": {
          "const": "percentile-bootstrap-of-process-means"
        }
      }
    }
  }
}
