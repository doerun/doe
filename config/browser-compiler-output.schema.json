{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct WGSL output experiment settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessions",
    "browser",
    "args",
    "viewport",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sessions": {
      "type": "integer",
      "minimum": 3
    },
    "browser": {
      "type": "string",
      "minLength": 1
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "string",
      "minLength": 1
    }
  }
}
