{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded Vulkan submission evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cohortOrder", "cleanProcessesPerLane", "maxRegressionFraction", "requiredRegressingPairs", "regressionMetrics", "materialPerformanceContract"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cohortOrder": {"const": ["baseline-1", "candidate-1", "candidate-2", "baseline-2"]},
    "cleanProcessesPerLane": {"type": "integer", "minimum": 1},
    "maxRegressionFraction": {"type": "number", "minimum": 0, "maximum": 1},
    "requiredRegressingPairs": {"type": "integer", "minimum": 1, "maximum": 2},
    "regressionMetrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["selectedOperationLatencyMs.p50", "selectedOperationLatencyMs.p95", "cleanProcessLatencyMs.p50", "cleanProcessLatencyMs.p95", "peakProcessTreeRssBytes"]}
    },
    "materialPerformanceContract": {"const": "bench/external-projects/umap-gpu/sgd-benchmark.harness.json"}
  }
}
