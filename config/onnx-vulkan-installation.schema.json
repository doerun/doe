{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "additionalProperties": false,
          "properties": {
            "cpuFallback": {
              "const": false
            },
            "dawnAbiCommit": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "excluded": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "onnxCore": {
              "minLength": 1,
              "type": "string"
            },
            "onnxProviderCommit": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "providerBuild": {
              "minLength": 1,
              "type": "string"
            },
            "validation": {
              "const": "full"
            }
          },
          "required": [
            "onnxCore",
            "onnxProviderCommit",
            "dawnAbiCommit",
            "cpuFallback",
            "validation",
            "providerBuild",
            "excluded"
          ],
          "type": "object"
        },
        "files": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  420,
                  493
                ]
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "sha256",
              "size",
              "mode"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        "kind": {
          "const": "doe-onnx-vulkan-evaluation"
        },
        "qualification": {
          "additionalProperties": false,
          "properties": {
            "applicationProcesses": {
              "minimum": 1,
              "type": "integer"
            },
            "fixtureDeadlineNs": {
              "minimum": 1,
              "type": "integer"
            },
            "processDeadlineSeconds": {
              "minimum": 1,
              "type": "integer"
            },
            "runsPerProcess": {
              "minimum": 1,
              "type": "integer"
            },
            "vendorId": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "vendorId",
            "applicationProcesses",
            "runsPerProcess",
            "fixtureDeadlineNs",
            "processDeadlineSeconds"
          ],
          "type": "object"
        },
        "schemaVersion": {
          "const": 1
        },
        "target": {
          "const": "linux-x64-amd-vulkan"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-eval\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "version",
        "target",
        "qualification",
        "compatibility",
        "kind",
        "files"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "archive": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "sha256",
            "size"
          ],
          "type": "object"
        },
        "builderSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "const": "doe-onnx-vulkan-archive"
        },
        "manifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "planSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "version",
        "archive",
        "manifestSha256",
        "planSha256",
        "builderSha256"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "externalAdoption": {
          "const": false
        },
        "host": {
          "additionalProperties": false,
          "properties": {
            "kernel": {
              "minLength": 1,
              "type": "string"
            },
            "machine": {
              "minLength": 1,
              "type": "string"
            },
            "system": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "system",
            "machine",
            "kernel"
          ],
          "type": "object"
        },
        "isolation": {
          "additionalProperties": false,
          "properties": {
            "checkoutExposure": {
              "const": "none"
            },
            "hostDevices": {
              "const": "/dev"
            },
            "network": {
              "const": "unshared"
            },
            "systemReadOnlyRoots": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            "writableRoots": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "checkoutExposure",
            "network",
            "systemReadOnlyRoots",
            "hostDevices",
            "writableRoots"
          ],
          "type": "object"
        },
        "jobs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifacts": {
                "additionalProperties": {
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "sha256": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "size": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "sha256",
                    "size",
                    "mode"
                  ],
                  "type": "object"
                },
                "type": "object"
              },
              "command": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "execution": {
                "additionalProperties": true,
                "description": "Raw typed fixture observations and application execution joins retain their native fields.",
                "type": [
                  "object",
                  "null"
                ]
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "failure": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "passed",
              "exitCode",
              "failure",
              "command",
              "execution",
              "artifacts"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "const": "doe-onnx-vulkan-installation"
        },
        "manifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "mode": {
          "enum": [
            "run",
            "qualify"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "performanceClaim": {
          "const": false
        },
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "version",
        "manifestSha256",
        "mode",
        "performanceClaim",
        "externalAdoption",
        "passed",
        "host",
        "isolation",
        "jobs"
      ],
      "type": "object"
    }
  ],
  "title": "ONNX Vulkan evaluation archive and installed acceptance"
}
