{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded candidate acceptance and requalification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "claimStatus",
    "status",
    "error",
    "jobHash",
    "candidateHash",
    "environmentHash",
    "previous",
    "environmentChanged",
    "requalification",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "program_candidate_acceptance"
    },
    "claimStatus": {
      "const": "diagnostic"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "jobHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "environmentChanged": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "requalification": {
      "const": "fresh-execution-required"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "isolation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "hash"
          ],
          "properties": {
            "path": {
              "const": "isolation.json"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "isolation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "isolation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "isolation": {
            "type": "object"
          }
        }
      }
    }
  ]
}
