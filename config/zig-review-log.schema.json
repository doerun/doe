{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zig hierarchical code review log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviews"],
  "properties": {
    "schemaVersion": {"const": 1},
    "reviews": {
      "type": "array",
      "items": {"$ref": "#/$defs/review"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId", "level", "targets", "status", "reviewer", "reviewedAt",
        "sourceCommit", "inputHash", "supersedes", "prerequisites", "context",
        "summary", "findings", "resolvedFindings", "evidence", "nextAction"
      ],
      "properties": {
        "reviewId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "level": {"enum": ["file", "directory", "within_directory", "cross_directory", "system"]},
        "targets": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "status": {"enum": ["in_progress", "needs_changes", "verified"]},
        "reviewer": {"$ref": "#/$defs/text"},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "inputHash": {"$ref": "#/$defs/hash"},
        "supersedes": {"type": ["string", "null"]},
        "prerequisites": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "context": {"type": "array", "items": {"$ref": "#/$defs/boundFile"}},
        "summary": {"$ref": "#/$defs/text"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "resolvedFindings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/boundFile"}},
        "nextAction": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {
            "properties": {
              "findings": {"maxItems": 0},
              "evidence": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"level": {"const": "cross_directory"}}},
          "then": {"properties": {"targets": {"minItems": 2}}},
          "else": {"properties": {"targets": {"maxItems": 1}}}
        }
      ]
    }
  }
}
