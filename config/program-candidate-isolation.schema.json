{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linux candidate process isolation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "maximumHostMemoryBytes",
    "maximumTasks",
    "maximumTemporaryBytes",
    "maximumFileBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "linux-bwrap-cgroup-v2"
    },
    "maximumHostMemoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumTasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumTemporaryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maximumFileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
