{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "classification",
    "verdict",
    "performanceClaim",
    "generalConformance",
    "sourceBaseCommit",
    "sourceSnapshots",
    "applicationProfiles",
    "historicalManifests",
    "custody",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "classification": {
      "const": "bounded-native-vulkan-callback-evidence"
    },
    "verdict": {
      "const": "qualified-tested-paths"
    },
    "performanceClaim": {
      "const": false
    },
    "generalConformance": {
      "const": false
    },
    "sourceBaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceSnapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot",
          "sha256"
        ],
        "properties": {
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minProperties": 1
    },
    "applicationProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doe",
        "dawn"
      ],
      "properties": {
        "doe": {
          "type": "string"
        },
        "dawn": {
          "type": "string"
        }
      }
    },
    "historicalManifests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minProperties": 1
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "members"
      ],
      "properties": {
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "path",
              "sha256"
            ],
            "properties": {
              "member": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "contentSha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minProperties": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded native Vulkan callback evidence"
}
