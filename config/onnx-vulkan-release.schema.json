{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "cpuFallback": {
          "const": false
        },
        "dawnAbiCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "excluded": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "onnxCore": {
          "minLength": 1,
          "type": "string"
        },
        "onnxProviderCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "providerBuild": {
          "minLength": 1,
          "type": "string"
        },
        "validation": {
          "const": "full"
        }
      },
      "required": [
        "onnxCore",
        "onnxProviderCommit",
        "dawnAbiCommit",
        "cpuFallback",
        "validation",
        "providerBuild",
        "excluded"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              420,
              493
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "mode"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "ownedFiles": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "qualification": {
      "additionalProperties": false,
      "properties": {
        "applicationProcesses": {
          "minimum": 1,
          "type": "integer"
        },
        "fixtureDeadlineNs": {
          "minimum": 1,
          "type": "integer"
        },
        "processDeadlineSeconds": {
          "minimum": 1,
          "type": "integer"
        },
        "runsPerProcess": {
          "minimum": 1,
          "type": "integer"
        },
        "vendorId": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "vendorId",
        "applicationProcesses",
        "runsPerProcess",
        "fixtureDeadlineNs",
        "processDeadlineSeconds"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "target": {
      "const": "linux-x64-amd-vulkan"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-eval\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "target",
    "qualification",
    "compatibility",
    "inputs",
    "ownedFiles"
  ],
  "title": "Pinned ONNX Vulkan evaluation release inputs",
  "type": "object"
}
