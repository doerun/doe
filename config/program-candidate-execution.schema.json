{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded candidate execution observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "claimStatus",
    "status",
    "error",
    "jobHash",
    "candidateHash",
    "backend",
    "execution",
    "preparation",
    "teardown",
    "environment",
    "cases",
    "timingScope",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "program_candidate"
    },
    "claimStatus": {
      "const": "diagnostic"
    },
    "status": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "jobHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend": {
      "enum": [
        "vulkan",
        "metal"
      ]
    },
    "execution": {
      "enum": [
        "gpu-recorded",
        "native-recorded",
        "webgpu"
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initializationMs",
            "preparationMs",
            "processPreparationMs"
          ],
          "properties": {
            "initializationMs": {
              "type": "number",
              "minimum": 0
            },
            "preparationMs": {
              "type": "number",
              "minimum": 0
            },
            "processPreparationMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initializationMs",
            "preparationMs",
            "processPreparationMs"
          ],
          "properties": {
            "initializationMs": {
              "type": "number",
              "minimum": 0
            },
            "preparationMs": {
              "type": "number",
              "minimum": 0
            },
            "processPreparationMs": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "teardownMs"
          ],
          "properties": {
            "teardownMs": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "teardownMs"
          ],
          "properties": {
            "teardownMs": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "environment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "node",
            "adapter",
            "loadedObjects",
            "kernelObjects"
          ],
          "properties": {
            "os": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "arch",
                "release"
              ],
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "arch": {
                  "type": "string",
                  "minLength": 1
                },
                "release": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "node": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "hash"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vendor",
                "architecture",
                "device",
                "description",
                "isFallbackAdapter",
                "vendorID",
                "deviceID",
                "driverVersion"
              ],
              "properties": {
                "vendor": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "architecture": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "device": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "isFallbackAdapter": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "vendorID": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "deviceID": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "driverVersion": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "loadedObjects": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "hash"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "kernelObjects": {
              "type": "array",
              "items": {
                "enum": [
                  "linux-vdso.so.1",
                  "linux-gate.so.1"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "samples",
          "referenceStatsMs",
          "candidateStatsMs",
          "ratios",
          "preparationRecoveryRuns",
          "accepted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "phase",
                "index",
                "elapsedMs",
                "cpuMs",
                "rpcMs",
                "processRssBytes",
                "receipt",
                "output",
                "numerical"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "reference",
                    "candidate"
                  ]
                },
                "phase": {
                  "enum": [
                    "first",
                    "warmup",
                    "timed"
                  ]
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "elapsedMs": {
                  "type": "number",
                  "minimum": 0
                },
                "cpuMs": {
                  "type": "number",
                  "minimum": 0
                },
                "rpcMs": {
                  "type": "number",
                  "minimum": 0
                },
                "processRssBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "receipt": {
                  "anyOf": [
                    {
                      "$ref": "compute-program-run.schema.json#/$defs/receipt"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "hash"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                "numerical": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "passed",
                    "maxAbsoluteError",
                    "firstFailure"
                  ],
                  "properties": {
                    "passed": {
                      "type": "boolean"
                    },
                    "maxAbsoluteError": {
                      "anyOf": [
                        {
                          "type": "number",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "firstFailure": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "referenceStatsMs": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "mean",
                  "min",
                  "max",
                  "median",
                  "p95",
                  "p99"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "mean": {
                    "type": "number",
                    "minimum": 0
                  },
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "median": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "candidateStatsMs": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "mean",
                  "min",
                  "max",
                  "median",
                  "p95",
                  "p99"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "mean": {
                    "type": "number",
                    "minimum": 0
                  },
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  },
                  "median": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p99": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ratios": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "p50",
                  "p95"
                ],
                "properties": {
                  "p50": {
                    "type": "number",
                    "minimum": 0
                  },
                  "p95": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "preparationRecoveryRuns": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "type": "boolean"
          }
        }
      }
    },
    "timingScope": {
      "const": "worker-input-clone-through-float32-result-including-gpu-readback"
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nativeTracePath": {
      "const": "native/native.jsonl"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "nativeTracePath"
        ]
      },
      "else": {
        "not": {
          "required": [
            "nativeTracePath"
          ]
        }
      }
    }
  ]
}
